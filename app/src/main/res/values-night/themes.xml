<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (night) - same palette as day, this is a game, not a system UI. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_primary_base</item>
        <item name="colorPrimaryVariant">@color/btn_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/wood_post_base</item>
        <item name="colorSecondaryVariant">@color/wood_post_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
