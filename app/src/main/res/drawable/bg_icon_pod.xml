<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#241206" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#5C2D0C" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="3dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#3B1C07"
                android:endColor="#291305" />
        </shape>
    </item>
</layer-list>
