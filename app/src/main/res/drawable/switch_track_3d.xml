<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked (Green 3D Pill) -->
    <item android:state_checked="true">
        <layer-list>
            <!-- Shadow -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#163409" />
                </shape>
            </item>
            <!-- Rim -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#214A0F" />
                </shape>
            </item>
            <!-- Vibrant Green face -->
            <item android:top="1dp" android:bottom="3dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#96E239"
                        android:centerColor="#6BBF23"
                        android:endColor="#438312" />
                </shape>
            </item>
            <!-- Highlight -->
            <item android:top="2dp" android:bottom="14dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#60FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Unchecked (Grey / Wood Inset) -->
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#361706" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="2dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#6E4420"
                        android:centerColor="#8F5C2F"
                        android:endColor="#A86F3E" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
