<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Drop Shadow -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#241004" />
        </shape>
    </item>

    <!-- Outer Dark Wood Rim -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#361705" />
        </shape>
    </item>

    <!-- Golden Carved Bevel -->
    <item android:top="2dp" android:bottom="6dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#F5B262" />
        </shape>
    </item>

    <!-- Inner Dark Stroke -->
    <item android:top="3dp" android:bottom="7dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#2E1303" />
        </shape>
    </item>

    <!-- Warm Mahogany/Oak Wooden Core Face -->
    <item android:top="4dp" android:bottom="8dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#DF8A3E"
                android:centerColor="#B85F1B"
                android:endColor="#873C0A" />
        </shape>
    </item>

    <!-- Top Gloss Reflex Reflection -->
    <item android:top="5dp" android:bottom="28dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="9dp"
                android:topRightRadius="9dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="2dp" />
            <gradient
                android:angle="270"
                android:startColor="#70FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
