<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#142B09" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="2dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4A8E20"
                        android:endColor="#6EB838" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State -->
    <item>
        <layer-list>
            <!-- Bottom 3D Drop Shadow Base -->
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#112407" />
                </shape>
            </item>
            <!-- Deep Dark Green Stroke -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#1A3B0C" />
                </shape>
            </item>
            <!-- Golden Inner Wooden Bevel -->
            <item android:top="2dp" android:bottom="5dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#F2AE52" />
                </shape>
            </item>
            <!-- Inner Dark Divider Stroke -->
            <item android:top="3dp" android:bottom="6dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <solid android:color="#18360B" />
                </shape>
            </item>
            <!-- Vibrant Cartoon Green Pill Surface -->
            <item android:top="4dp" android:bottom="7dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#8DE038"
                        android:centerColor="#60B022"
                        android:endColor="#438614" />
                </shape>
            </item>
            <!-- Top Gloss Reflex Reflection -->
            <item android:top="5dp" android:bottom="36dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="9dp"
                        android:topRightRadius="9dp"
                        android:bottomLeftRadius="2dp"
                        android:bottomRightRadius="2dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#70FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
