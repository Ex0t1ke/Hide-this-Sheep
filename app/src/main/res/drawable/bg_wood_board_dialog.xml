<?xml version="1.0" encoding="utf-8"?>
<!--
  Same wood-board look as bg_wood_board.xml, but WITHOUT the hardcoded horizontal
  plank-seam lines (those were placed at fixed absolute dp offsets — 115/205/295/
  385/475dp — tuned for the tall level-select board only). Reusing bg_wood_board on
  short dialogs (mode select, level start) made those seam lines land in the middle
  of buttons/text and look like stray glitch lines. Use this drawable for any
  wood-board-styled dialog/card instead.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outermost dark outline shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#241105" />
        </shape>
    </item>

    <!-- 2. Wood bevel rim -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <solid android:color="#8E5222" />
        </shape>
    </item>

    <!-- 3. Inner dark carved groove -->
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <solid android:color="#351806" />
        </shape>
    </item>

    <!-- 4. Inner wood plank body -->
    <item
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#CA8D49"
                android:centerColor="#BA7A38"
                android:endColor="#A26226" />
        </shape>
    </item>
</layer-list>
