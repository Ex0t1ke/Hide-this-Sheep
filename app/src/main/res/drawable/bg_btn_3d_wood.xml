<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Drop Shadow -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#220E03" />
                </shape>
            </item>
            <!-- Rim -->
            <item android:top="2dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <!-- Face -->
            <item android:top="4dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#A35D23"
                        android:centerColor="#8F4F1C"
                        android:endColor="#783F14" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal 3D state -->
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#1A0A02" />
                </shape>
            </item>
            <!-- Outer 3D Wood Rim / Extrusion -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <!-- 3D Bevel Ridge -->
            <item android:top="2dp" android:bottom="7dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#68340E" />
                </shape>
            </item>
            <!-- Warm Wood Surface Gradient -->
            <item android:top="2dp" android:bottom="8dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#E6A15E"
                        android:centerColor="#D4863E"
                        android:endColor="#AA5C1E" />
                </shape>
            </item>
            <!-- Top Light Highlight -->
            <item android:top="3dp" android:bottom="28dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#55FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
