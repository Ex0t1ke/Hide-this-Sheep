<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#200E04" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <item android:top="4dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#8A4E1B"
                        android:centerColor="#743E14"
                        android:endColor="#5C2F0C" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal 3D state -->
    <item>
        <layer-list>
            <!-- 3D Shadow Base -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#1A0B03" />
                </shape>
            </item>
            <!-- Outer Dark Wood Rim -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <!-- Golden Bevel Edge -->
            <item android:top="2dp" android:bottom="5dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#E09C48" />
                </shape>
            </item>
            <!-- Dark Inset Divider -->
            <item android:top="3dp" android:bottom="6dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="#321605" />
                </shape>
            </item>
            <!-- Warm Wooden Core Face -->
            <item android:top="4dp" android:bottom="7dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B87032"
                        android:centerColor="#9E5A22"
                        android:endColor="#7B4115" />
                </shape>
            </item>
            <!-- Top Light Reflection Reflex -->
            <item android:top="5dp" android:bottom="48dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="10dp"
                        android:topRightRadius="10dp"
                        android:bottomLeftRadius="2dp"
                        android:bottomRightRadius="2dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#50FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
