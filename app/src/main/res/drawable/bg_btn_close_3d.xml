<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#3A0808" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#580D0D" />
                </shape>
            </item>
            <item android:top="4dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B82424"
                        android:endColor="#8A1313" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal 3D state -->
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#300707" />
                </shape>
            </item>
            <!-- 3D Bottom Base Rim -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#5C0E0E" />
                </shape>
            </item>
            <!-- 3D Bevel Ridge -->
            <item android:top="1dp" android:bottom="5dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <solid android:color="#9E1818" />
                </shape>
            </item>
            <!-- Vibrant Red Face -->
            <item android:top="2dp" android:bottom="6dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#F44336"
                        android:centerColor="#D32F2F"
                        android:endColor="#B71C1C" />
                </shape>
            </item>
            <!-- Top Gloss Highlight -->
            <item android:top="3dp" android:bottom="22dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#65FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
