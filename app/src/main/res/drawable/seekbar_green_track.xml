<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inset wooden trough / groove -->
    <item android:id="@android:id/background" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#4A260F"
                android:centerColor="#78441F"
                android:endColor="#945B2C" />
            <stroke android:width="1.5dp" android:color="#361706" />
        </shape>
    </item>

    <!-- 3D Volumetric Green Progress Fill (Tube / Capsule) -->
    <item android:id="@android:id/progress" android:top="5dp" android:bottom="5dp">
        <clip>
            <layer-list>
                <!-- Base dark stroke / 3D extrusion under progress -->
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="11dp" />
                        <solid android:color="#1A3E0A" />
                    </shape>
                </item>
                <!-- Main 3D Green Cylinder Body -->
                <item android:top="1dp" android:bottom="2dp" android:left="1dp" android:right="1dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="10dp" />
                        <gradient
                            android:angle="270"
                            android:startColor="#B2F848"
                            android:centerColor="#76D224"
                            android:endColor="#3F8511" />
                    </shape>
                </item>
                <!-- Top Tubular Gloss Reflection Highlight -->
                <item android:top="2dp" android:bottom="9dp" android:left="4dp" android:right="4dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="6dp" />
                        <gradient
                            android:angle="270"
                            android:startColor="#90FFFFFF"
                            android:endColor="#00FFFFFF" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
