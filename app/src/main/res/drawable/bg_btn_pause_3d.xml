<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Depressed down with dark shadow -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow base -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#241004" />
                </shape>
            </item>
            <!-- Dark rim -->
            <item android:top="2dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#3A1C08" />
                </shape>
            </item>
            <!-- Pressed face -->
            <item android:top="4dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#8A4614"
                        android:centerColor="#783B0E"
                        android:endColor="#622E08" />
                </shape>
            </item>
            <!-- Pause Bar Left -->
            <item android:top="13dp" android:bottom="11dp" android:left="15dp" android:right="25dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#FFF0DB" />
                </shape>
            </item>
            <!-- Pause Bar Right -->
            <item android:top="13dp" android:bottom="11dp" android:left="25dp" android:right="15dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#FFF0DB" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal default 3D state -->
    <item>
        <layer-list>
            <!-- 3D Bottom Drop Shadow -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#1A0B03" />
                </shape>
            </item>
            <!-- Outer Dark Wood Rim / Extrusion -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <!-- 3D Bevel Ridge -->
            <item android:top="1dp" android:bottom="5dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="#6E3812" />
                </shape>
            </item>
            <!-- Warm Wood Face Gradient -->
            <item android:top="2dp" android:bottom="6dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#F0AB60"
                        android:centerColor="#D68434"
                        android:endColor="#A85718" />
                </shape>
            </item>
            <!-- Top Gloss Highlight -->
            <item android:top="3dp" android:bottom="24dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="9dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#60FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <!-- Pause Bar Left Shadow -->
            <item android:top="13dp" android:bottom="12dp" android:left="15dp" android:right="25dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <!-- Pause Bar Left -->
            <item android:top="11dp" android:bottom="14dp" android:left="15dp" android:right="25dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#FFF8EE" />
                </shape>
            </item>
            <!-- Pause Bar Right Shadow -->
            <item android:top="13dp" android:bottom="12dp" android:left="25dp" android:right="15dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#361705" />
                </shape>
            </item>
            <!-- Pause Bar Right -->
            <item android:top="11dp" android:bottom="14dp" android:left="25dp" android:right="15dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#FFF8EE" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
