<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grass_base_dark"
    tools:context=".MainActivity">

    <!-- Scenic Fullscreen Pasture Background & Dynamic Canvas Field -->
    <com.example.myapplication.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top HUD matching Image 3 Panel 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 3D Wooden Pause Button '||' -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_pause_3d"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Пауза"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Wooden Level Pill 'УРОВЕНЬ 1' -->
        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_hud_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="УРОВЕНЬ 1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.04"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Wooden Star Pill '0/3' -->
        <LinearLayout
            android:id="@+id/chipStars"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_pill"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_gold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStarsDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="0/3"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Status banner notification (floats temporarily) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hud_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:fontFamily="sans-serif-bold"
        android:text="Стадо в безопасности!"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/topHud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Dock matching Image 3 Panel 1 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cards Row: Sheep & Fence side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Sheep Card -->
            <FrameLayout
                android:id="@+id/cardSheep"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_item"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="ОВЦА"
                    android:textColor="#FFF3DE"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_icon_sheep"
                    android:contentDescription="Овца" />

                <TextView
                    android:id="@+id/tvCardSheepCount"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_hud_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="x1"
                    android:textColor="#FFFDF0"
                    android:textSize="12sp"
                    android:shadowColor="#281305"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </FrameLayout>

            <!-- Fence Card -->
            <FrameLayout
                android:id="@+id/cardFence"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_item"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="ЗАБОР"
                    android:textColor="#FFF3DE"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_icon_fence"
                    android:contentDescription="Забор" />

                <TextView
                    android:id="@+id/tvFenceOrientation"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_hud_pill"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="↔ 2x"
                    android:textColor="#FFFDF0"
                    android:textSize="11sp"
                    android:shadowColor="#281305"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2" />

                <TextView
                    android:id="@+id/tvCardFenceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_hud_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="x8"
                    android:textColor="#FFFDF0"
                    android:textSize="12sp"
                    android:shadowColor="#281305"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </FrameLayout>
        </LinearLayout>

        <!-- Big 3D Green Action Button 'ПРОВЕРИТЬ ЗАЩИТУ' -->
        <Button
            android:id="@+id/btnStartWolves"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_3d_green"
            app:backgroundTint="@null"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:text="ПРОВЕРИТЬ ЗАЩИТУ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:letterSpacing="0.03"
            android:shadowColor="#18360B"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <!-- Secondary Controls: 3D Wooden Undo & Reset Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_3d_wood"
                app:backgroundTint="@null"
                android:fontFamily="sans-serif-black"
                android:text="ОТМЕНИТЬ"
                android:textColor="#FFF3DE"
                android:textSize="13sp"
                android:letterSpacing="0.03"
                android:shadowColor="#281305"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_3d_wood"
                app:backgroundTint="@null"
                android:fontFamily="sans-serif-black"
                android:text="ЗАНОВО"
                android:textColor="#FFF3DE"
                android:textSize="13sp"
                android:letterSpacing="0.03"
                android:shadowColor="#281305"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden compatibility views for code bindings -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints">

        <TextView android:id="@+id/tvSheepCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvWolfCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvFenceCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnRestart" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
