<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grass_base_dark"
    tools:context=".SettingsActivity">

    <!-- Scenic Fullscreen Background -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu_cover"
        android:alpha="0.35"
        android:contentDescription="Фон" />

    <!-- Center Pop-up Settings Dialog Card matching 2 panels.png Right Panel -->
    <FrameLayout
        android:id="@+id/dialog_frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Parchment Dialogue Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_parchment_dialog"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="38dp"
            android:paddingBottom="24dp"
            android:layout_marginTop="22dp">

            <!-- 1. Music Setting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_music_note"
                    android:contentDescription="Музыка" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="МУЗЫКА"
                        android:textColor="#3D1E08"
                        android:textSize="14sp"
                        android:letterSpacing="0.05" />

                    <SeekBar
                        android:id="@+id/sb_bgm"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="70"
                        android:progressDrawable="@drawable/seekbar_green_track"
                        android:thumb="@drawable/bg_slider_thumb"
                        android:splitTrack="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Sound Effects Setting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_sound_fx"
                    android:contentDescription="Звуковые эффекты" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="ЗВУКОВЫЕ ЭФФЕКТЫ"
                        android:textColor="#3D1E08"
                        android:textSize="14sp"
                        android:letterSpacing="0.05" />

                    <SeekBar
                        android:id="@+id/sb_sfx"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="80"
                        android:progressDrawable="@drawable/seekbar_green_track"
                        android:thumb="@drawable/bg_slider_thumb"
                        android:splitTrack="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Vibration Setting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_vibration"
                    android:contentDescription="Вибрация" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="ВИБРАЦИЯ"
                    android:textColor="#3D1E08"
                    android:textSize="14sp"
                    android:letterSpacing="0.05" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_vibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:track="@drawable/switch_track_3d"
                    android:thumb="@drawable/switch_thumb_3d" />
            </LinearLayout>

            <!-- 4. Reset Progress Button -->
            <FrameLayout
                android:id="@+id/btn_reset_progress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_wood_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="СБРОСИТЬ ПРОГРЕСС"
                    android:textColor="#FFF3DE"
                    android:textSize="14sp"
                    android:letterSpacing="0.04"
                    android:shadowColor="#281305"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3" />
            </FrameLayout>

        </LinearLayout>

        <!-- Wooden Header Plank with 'НАСТРОЙКИ' -->
        <FrameLayout
            android:layout_width="196dp"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_wood_header_plank">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-black"
                android:text="НАСТРОЙКИ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:letterSpacing="0.05"
                android:shadowColor="#281305"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3" />
        </FrameLayout>

        <!-- Red 3D Close 'X' Button on top-right corner matching 2 panels.png -->
        <FrameLayout
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_btn_close_3d"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Закрыть">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-black"
                android:text="✖"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:shadowColor="#420A0A"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3" />
        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
