<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_wood_board"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp">

            <!-- Title Header Plank -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="ГАЙД ПО ИГРЕ"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:letterSpacing="0.04"
                android:shadowColor="#281305"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:fontFamily="sans-serif-bold"
                android:text="Защитите стадо от голодных волков!"
                android:textColor="#FFD54F"
                android:textSize="13sp" />

            <!-- Core Rules Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_recessed_stats"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="#FFF3DE"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:text="• Поместите овечек в безопасную зону поля\n• Забор занимает 2 клетки: нажмите на карту, чтобы повернуть (↔ / ↕)\n• Волк может ходить по диагонали — закрывайте все 8 направлений!\n• Потратьте не больше половины заборов для 3 звёзд ★★★" />
            </LinearLayout>

            <!-- Mode Selector Tabs: КАК НЕЛЬЗЯ vs КАК НАДО -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_tab_bad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_btn_3d_wood"
                    app:backgroundTint="@null"
                    android:fontFamily="sans-serif-black"
                    android:text="✗ КАК НЕЛЬЗЯ"
                    android:textAllCaps="false"
                    android:textColor="#FFCDD2"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_tab_good"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_btn_3d_green"
                    app:backgroundTint="@null"
                    android:fontFamily="sans-serif-black"
                    android:text="✓ КАК НАДО"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Interactive Animated Demonstration View -->
            <com.example.myapplication.TutorialDemoView
                android:id="@+id/tutorial_demo_view"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginBottom="16dp" />

            <!-- Close Action Button -->
            <Button
                android:id="@+id/btn_tutorial_ok"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_3d_green"
                app:backgroundTint="@null"
                android:fontFamily="sans-serif-black"
                android:text="ПОНЯТНО, В БОЙ!"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:shadowColor="#18360B"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
