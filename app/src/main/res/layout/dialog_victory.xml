<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_wood_board"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_victory_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="Уровень пройден!"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:letterSpacing="0.02"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <!-- Animated 3 Stars Container -->
        <LinearLayout
            android:id="@+id/container_victory_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_star1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Звезда 1" />

            <ImageView
                android:id="@+id/iv_star2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="6dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Звезда 2" />

            <ImageView
                android:id="@+id/iv_star3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Звезда 3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_victory_stars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:fontFamily="sans-serif-bold"
            android:text="Безупречная защита"
            android:textColor="#FFD54F"
            android:textSize="17sp" />

        <!-- Stats in recessed container -->
        <TextView
            android:id="@+id/tv_victory_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_recessed_stats"
            android:padding="12dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_victory_next"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_green_play"
            app:backgroundTint="@null"
            android:text="Следующий уровень"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:shadowColor="#18360B"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2" />

        <Button
            android:id="@+id/btn_victory_retry"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_wood_card"
            app:backgroundTint="@null"
            android:text="Попробовать снова"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <Button
            android:id="@+id/btn_victory_menu"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_wood_card"
            app:backgroundTint="@null"
            android:text="В главное меню"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

</FrameLayout>
