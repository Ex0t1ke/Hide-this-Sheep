<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_dim_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Parchment card, same visual language as dialog_settings.xml so it never
         renders as invisible floating text (previous bug: default AlertDialog
         with a transparent windowBackground has no panel at all). -->
    <LinearLayout
        android:id="@+id/dialog_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_parchment_dialog"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_confirm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="Сбросить прогресс?"
            android:textColor="#3D1E08"
            android:textSize="18sp"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tv_confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Все открытые уровни кампании и заработанные звёзды будут сброшены. Вы уверены?"
            android:textColor="#5A3719"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_confirm_cancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_wood_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="ОТМЕНА"
                    android:textColor="#FFF3DE"
                    android:textSize="13sp"
                    android:shadowColor="#281305"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_confirm_ok"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_tertiary"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="СБРОСИТЬ"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#420A0A"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
