<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_wood_board"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_pause_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="Пауза"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:letterSpacing="0.04"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/tv_pause_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:fontFamily="sans-serif-bold"
            android:text="Уровень 1"
            android:textColor="#FFD54F"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_pause_resume"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_green_play"
            app:backgroundTint="@null"
            android:text="Продолжить"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:shadowColor="#18360B"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2" />

        <Button
            android:id="@+id/btn_pause_restart"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_wood_card"
            app:backgroundTint="@null"
            android:text="Заново"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <Button
            android:id="@+id/btn_pause_menu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_wood_card"
            app:backgroundTint="@null"
            android:text="В главное меню"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:shadowColor="#281305"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

</FrameLayout>
